---
import Base from '../../layouts/Base.astro';
import Word from '../../components/Word.astro';
import Incomplete from '../../components/Incomplete.astro';
import { getCollection, getEntries, render } from 'astro:content';
import { url } from '../../lib/url';
import { formatDate, POS_LABEL, POS_ORDER } from '../../lib/vocab';
import { modes } from '../../lib/quiz-modes.js';
import { existsSync } from 'node:fs';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => ({ params: { number: String(lesson.data.number) }, props: { lesson } }));
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
const nn = String(lesson.data.number).padStart(2, '0');
// Originals copied to public/sources/lesson-NN/ are linked; anything else is shown as plain text.
const sources = lesson.data.sources.map((name) => ({
  name,
  href: existsSync(`public/sources/lesson-${nn}/${name}`) ? url(`/sources/lesson-${nn}/${name}`) : null,
}));
const topics = await getEntries(lesson.data.topics);
const vocab = (await getCollection('vocab'))
  .filter((v) => v.data.lesson === lesson.data.number)
  .map((v) => v.data);

const exercises = (await getCollection('exercises'))
  .filter((e) => e.data.lesson === lesson.data.number)
  .map((e) => e.data);
const SET_LABEL: Record<string, string> = {
  'trennbar-praesens': 'Separable verbs, present tense',
  'trennbar-modal': 'Separable verbs with modal verbs',
  gemischt: 'Mixed separable and inseparable verbs',
  'artikel-bestimmt': 'Definite article in a sentence',
  'artikel-unbestimmt': 'Indefinite article in a sentence',
  'dativ-objekt': 'Dative: the indirect object',
  'dativ-verben': 'Dative: verbs that take the dative',
  'akkusativ-bestimmt': 'Accusative: den / die / das',
  'akkusativ-unbestimmt': 'Accusative: einen / eine / ein',
  'schwach-praesens': 'Weak verbs, present tense',
  'l4-dativ': 'Dativ: the indirect object',
  'l4-dativ-verben': 'Dativ: verbs with the dative',
  'l4-akkusativ': 'Akkusativ: den / die / das',
  'l4-akkusativ-2': 'Akkusativ: einen / eine / ein',
};
const sets = [...new Set(exercises.map((e) => e.set))].map((set) => ({
  set,
  label: SET_LABEL[set] ?? set,
  count: exercises.filter((e) => e.set === set).length,
  mode: modes.find((m) => m.source === 'exercises' && exercises.some((e) => e.set === set && m.filter(e)))?.id,
}));

const essentialCount = vocab.filter((v) => v.tags.includes('essentials')).length;
const groups = POS_ORDER
  .map((pos) => ({ pos, label: POS_LABEL[pos], items: vocab.filter((v) => v.pos === pos) }))
  .filter((g) => g.items.length > 0);
const untyped = vocab.filter((v) => !v.pos);
if (untyped.length) groups.push({ pos: 'other', label: 'Other', items: untyped });

const all = await getCollection('lessons');
const prev = all.find((l) => l.data.number === lesson.data.number - 1);
const next = all.find((l) => l.data.number === lesson.data.number + 1);
---
<Base title={`Lesson ${lesson.data.number}`}>
  <header class="head">
    <p class="small muted">
      <time datetime={lesson.data.date.toISOString().slice(0, 10)}>{formatDate(lesson.data.date)}</time>
      {sources.length > 0 && (
        <> · Materials: {sources.map((s, i) => (
          <>{i > 0 && ', '}{s.href ? <a href={s.href}>{s.name}</a> : s.name}</>
        ))}</>
      )}
    </p>
    <h1>Lesson {lesson.data.number}{lesson.data.title && <span class="subtitle">: {lesson.data.title}</span>}</h1>
    {topics.length > 0 && (
      <ul class="topics">
        {topics.map((t) => (
          <li><a class="chip" href={url(`/grammar/${t.id}/`)}>{t.data.title}</a></li>
        ))}
      </ul>
    )}
  </header>

  <section class="section" aria-labelledby="hw">
    <h2 id="hw">Homework</h2>
    {lesson.data.homework.length === 0 ? (
      <p class="muted">No homework recorded for this lesson.</p>
    ) : (
      <ul class="homework">
        {lesson.data.homework.map((h) => {
          const setsOf = h.sets.map((set) => ({
            set,
            label: SET_LABEL[set] ?? set,
            count: exercises.filter((e) => e.set === set).length,
            mode: modes.find((m) => m.source === 'exercises' && exercises.some((e) => e.set === set && m.filter(e)))?.id,
          }));
          return (
            <li class:list={{ done: h.done }}>
              <div class="hw-head">
                <span class="box" aria-hidden="true">{h.done ? '☑' : '☐'}</span>
                <span class="visually-hidden">{h.done ? 'Done:' : 'Open:'}</span>
                <span>
                  {h.text}
                  {h.source && <> · <a href={url(`/sources/lesson-${nn}/${h.source}`)}>open the sheet</a></>}
                  {h.quiz && <> · <a class="btn btn-primary small" href={url('/quiz/') + `?mode=${h.quiz}`}>Practise</a></>}
                </span>
              </div>
              {setsOf.length > 0 && (
                <ul class="hw-sets">
                  {setsOf.map((s) => (
                    <li>
                      <span>{s.label} <span class="muted small">({s.count})</span></span>
                      {s.mode && <a class="btn btn-primary small" href={url('/quiz/') + `?mode=${s.mode}&sheet=${s.set}&title=${encodeURIComponent(s.label)}&back=lessons/${lesson.data.number}/`}>Do the sheet</a>}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    )}
    <div
      id="sheet-results"
      hidden
      data-sets={JSON.stringify(lesson.data.homework.flatMap((h) => h.sets))}
      data-set-ids={JSON.stringify(Object.fromEntries(lesson.data.homework.flatMap((h) => h.sets).map((set) => [set, exercises.filter((e) => e.set === set).map((e) => e.id)])))}
      data-set-labels={JSON.stringify(Object.fromEntries(lesson.data.homework.flatMap((h) => h.sets).map((set) => [set, SET_LABEL[set] ?? set])))}
    >
      <h3>Results on this device</h3>
      <table class="results">
        <thead><tr><th>Sheet</th><th>Score</th><th>Completed</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <section class="section prose" aria-labelledby="notes">
    <h2 id="notes">Notes</h2>
    <Content />
  </section>

  <section class="section" aria-labelledby="vocab">
    <h2 id="vocab">Vocabulary <span class="muted small">({essentialCount} essentials · {vocab.length} total)</span></h2>
    <p class="small muted">Essentials are shown; <button type="button" class="linkish" id="show-all">show all {vocab.length} words</button>.</p>
    {groups.map((g) => (
      <div class="group">
        <h3>{g.label} <span class="muted small">({g.items.length})</span></h3>
        <ul class="words">
          {g.items.map((e) => (
            <li class:list={{ extra: !e.tags.includes('essentials') }} hidden={!e.tags.includes('essentials')}>
              <span class="de"><Word german={e.german} /> <Incomplete entry={e} /></span>
              <span class="en">{e.english}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <p class="small"><a href={url(`/vocab/`) + `?lesson=${lesson.data.number}`}>Open in the vocab table →</a></p>
    <script>
      // Results of the homework sheets on this lesson, from this browser's storage.
      {
        const sets = new Set(JSON.parse(document.getElementById('sheet-results')!.dataset.sets || '[]'));
        let rows: any[] = [];
        try { rows = JSON.parse(localStorage.getItem('german-sheet-results') || '[]') || []; } catch { rows = []; }
        rows = rows.filter((r) => sets.has(r.sheet));
        // Sheets done before runs were recorded: reconstruct from the per-question history.
        const setIds: Record<string, string[]> = JSON.parse(document.getElementById('sheet-results')!.dataset.setIds || '{}');
        const labels: Record<string, string> = JSON.parse(document.getElementById('sheet-results')!.dataset.setLabels || '{}');
        let stats: Record<string, any> = {};
        try { stats = JSON.parse(localStorage.getItem('german-quiz-stats-v1') || '{}') || {}; } catch { stats = {}; }
        for (const [set, ids] of Object.entries(setIds)) {
          if (rows.some((r) => r.sheet === set)) continue;
          const done = ids.map((id) => stats[id]).filter(Boolean);
          if (!done.length) continue;
          const firstTry = done.filter((x) => x.errors === 0).length;
          const latest = done.filter((x) => x.lastCorrect !== undefined);
          const latestRight = latest.filter((x) => x.lastCorrect).length;
          rows.push({
            sheet: set, title: labels[set] ?? set, derived: true,
            answered: done.length, total: ids.length, correct: firstTry,
            latest: latest.length ? `${latestRight} / ${latest.length} right on the latest try` : null,
            complete: done.length === ids.length, at: new Date(Math.max(...done.map((x) => x.last || 0))).toISOString(),
          });
        }
        if (rows.length) {
          const box = document.getElementById('sheet-results')!;
          const tb = box.querySelector('tbody')!;
          for (const r of rows) {
            const tr = document.createElement('tr');
            const pct = r.answered ? Math.round((100 * r.correct) / r.answered) : 0;
            let score = r.complete ? `${pct} % (${r.correct} / ${r.total})` : `${pct} % (${r.correct} / ${r.answered}, ended early)`;
            if (r.derived) score = `${pct} % right first time (${r.correct} / ${r.answered} answered${r.complete ? '' : ` of ${r.total}`})${r.latest ? ` · ${r.latest}` : ''}`;
            tr.innerHTML = `<td>${r.title}</td><td>${score}</td><td>${new Date(r.at).toLocaleString()}</td>`;
            tb.append(tr);
          }
          box.hidden = false;
        }
      }
      document.getElementById('show-all')?.addEventListener('click', (ev) => {
        document.querySelectorAll<HTMLElement>('.words li.extra').forEach((li) => (li.hidden = false));
        (ev.currentTarget as HTMLElement).closest('p')!.hidden = true;
      });
    </script>
  </section>

  {sets.length > 0 && (
    <section class="section" aria-labelledby="ex">
      <h2 id="ex">Exercises <span class="muted small">({exercises.length} sentences)</span></h2>
      <ul class="sets">
        {sets.map((s) => (
          <li>
            <span>{s.label} <span class="muted small">({s.count})</span></span>
            {s.mode && (
              <span class="set-links">
                <a class="btn" href={url('/quiz/') + `?mode=${s.mode}`}>Drill</a>
                <a class="btn btn-primary" href={url('/quiz/') + `?mode=${s.mode}&sheet=${s.set}&title=${encodeURIComponent(s.label)}&back=lessons/${lesson.data.number}/`}>Do the sheet</a>
              </span>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <nav class="pager" aria-label="Lesson navigation">
    {prev ? <a href={url(`/lessons/${prev.data.number}/`)}>← Lesson {prev.data.number}</a> : <span />}
    {next ? <a href={url(`/lessons/${next.data.number}/`)}>Lesson {next.data.number} →</a> : <span />}
  </nav>
</Base>

<style>
  .subtitle { font-weight: 400; color: var(--muted); }
  .topics { list-style: none; padding: 0; margin: 0.25rem 0 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .topics a { text-decoration: none; }
  .section { margin-top: 2rem; }
  .homework { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; max-width: 40rem; }
  .homework > li.done .hw-head { color: var(--muted); text-decoration: line-through; }
  .hw-head { display: flex; gap: 0.5rem; align-items: baseline; }
  .hw-sets { list-style: none; padding: 0; margin: 0.4rem 0 0 1.6rem; display: grid; gap: 0.3rem; }
  .hw-sets li { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.3rem 0; border-bottom: 1px solid var(--border); }
  .btn.small { padding: 0.3em 0.8em; font-size: 0.9rem; }
  #sheet-results { margin-top: 1rem; max-width: 40rem; }
  #sheet-results h3 { margin: 0 0 0.4rem; font-size: 0.95rem; }
  .results { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .results th, .results td { text-align: left; padding: 0.3em 0.5em; border-bottom: 1px solid var(--border); }
  .box { font-size: 1.1em; }
  .group h3 { margin-top: 1.25rem; }
  /* one grid for the whole list so the English column lines up across rows */
  .words { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: max-content 1fr; column-gap: 1.25rem; max-width: 46rem; }
  .words li { display: contents; }
  .words li > span { padding: 0.35rem 0; border-bottom: 1px solid var(--border); }
  .en { color: var(--muted); }
  @media (max-width: 30rem) {
    .words { grid-template-columns: minmax(8rem, max-content) 1fr; column-gap: 0.75rem; }
  }
  .sets { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.4rem; max-width: 40rem; }
  .sets li { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.4rem 0; border-bottom: 1px solid var(--border); }
  .set-links { display: flex; gap: 0.4rem; flex: none; }
  .linkish { all: unset; cursor: pointer; color: var(--accent); text-decoration: underline; }
  .pager { display: flex; justify-content: space-between; margin-top: 3rem; }
</style>
