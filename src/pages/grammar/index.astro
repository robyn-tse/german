---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';

const topics = (await getCollection('grammar')).sort((a, b) => a.data.order - b.data.order);
const isEmpty = (t: (typeof topics)[number]) => !(t.body ?? '').trim();
const filled = topics.filter((t) => !isEmpty(t)).length;
---
<Base title="Grammar">
  <h1>Grammar</h1>
  <p class="muted small">The 10-topic curriculum. {filled} of {topics.length} topics have notes so far; grey ones are still empty.</p>
  <ol class="topics">
    {topics.map((t) => {
      const empty = isEmpty(t);
      return (
        <li class:list={['card', { empty }]}>
          <span class="order" aria-hidden="true">{t.data.order}</span>
          <div>
            <a href={url(`/grammar/${t.id}/`)}>{t.data.title}</a>
            <div class="small muted">
              {empty ? (
                <span class="status">Not covered yet</span>
              ) : (
                <>Lessons {t.data.lessons.join(', ')} · last updated in lesson {t.data.last_updated_lesson}</>
              )}
            </div>
          </div>
        </li>
      );
    })}
  </ol>
</Base>

<style>
  .topics { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.5rem; max-width: 40rem; counter-reset: t; }
  .topics li { display: flex; gap: 0.9rem; align-items: center; padding: 0.7rem 0.9rem; }
  .topics a { font-weight: 600; color: inherit; }
  .order { width: 1.8rem; height: 1.8rem; border-radius: 50%; display: grid; place-items: center; font-size: 0.85rem; font-weight: 600; background: var(--accent); color: var(--accent-fg); flex: none; }
  .empty { background: transparent; border-style: dashed; }
  .empty .order { background: var(--surface-2); color: var(--muted); }
  .empty a { color: var(--muted); font-weight: 500; }
  .status { font-style: italic; }
</style>
