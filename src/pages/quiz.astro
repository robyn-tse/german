---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { modes } from '../lib/quiz-modes.js';

const entries = (await getCollection('vocab')).map((v) => v.data);
const exercises = (await getCollection('exercises')).map((v) => v.data);
const rules = (await getCollection('genderRules')).map((v) => v.data);
const lessons = [...new Set([...entries, ...exercises, ...rules].map((e) => e.lesson))].sort((a, b) => a - b);
const tags = [...new Set(entries.flatMap((e) => e.tags))].sort();
const minLesson = lessons[0] ?? 1;
const maxLesson = lessons[lessons.length - 1] ?? 1;
---
<Base title="Quiz">
  <h1>Quiz</h1>

  <!-- ---------------------------------------------------------------- setup -->
  <form id="setup" class="setup" aria-label="Quiz setup">
    <fieldset>
      <legend>Mode</legend>
      {[...new Set(modes.map((m) => m.group ?? 'Other'))].map((group) => (
        <div class="mode-group">
          <h3 class="group-title">{group}</h3>
          <div class="modes">
            {modes.filter((m) => (m.group ?? 'Other') === group).map((m) => (
              <label class="mode">
                <input type="radio" name="mode" value={m.id} checked={m.id === modes[0].id} />
                <span class="mode-label">{m.label}</span>
                <span class="mode-desc small muted">{m.description}</span>
                <span class="mode-count small muted" data-mode-count={m.id}></span>
              </label>
            ))}
          </div>
        </div>
      ))}
    </fieldset>

    <fieldset>
      <legend>Style</legend>
      <div class="styles">
        <label class="mode"><input type="radio" name="style" value="quiz" checked /><span class="mode-label">Quiz</span><span class="mode-desc small muted">Type or choose the answer; it is checked for you.</span></label>
        <label class="mode"><input type="radio" name="style" value="cards" /><span class="mode-label">Flashcards</span><span class="mode-desc small muted">Flip the card, then rate yourself: Again or Got it.</span></label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Filter</legend>
      <div class="row">
        <label>Lessons
          <span class="range">
            <input type="number" name="from" min={minLesson} max={maxLesson} value={minLesson} inputmode="numeric" aria-label="From lesson" />
            <span aria-hidden="true">–</span>
            <input type="number" name="to" min={minLesson} max={maxLesson} value={maxLesson} inputmode="numeric" aria-label="To lesson" />
          </span>
        </label>
        <label>Tag
          <select name="tag">
            <option value="">any</option>
            {tags.filter((t) => t !== 'essentials').map((t) => <option value={t}>{t}</option>)}
          </select>
        </label>
        <label class="check"><input type="checkbox" name="essentials" checked /> Essentials only</label>
        <label>Questions
          <input type="number" name="length" min="1" max="200" value="15" inputmode="numeric" />
        </label>
      </div>
    </fieldset>

    <p class="small muted" id="pool"></p>
    <button type="submit" class="btn btn-primary" id="start">Start</button>
  </form>

  <!-- ------------------------------------------------------------- question -->
  <section id="play" class="play" hidden aria-live="polite">
    <p class="progress small muted"><span id="qnum"></span> · <span id="mode-name"></span></p>
    <p class="prompt" id="prompt" lang="de"></p>
    <p class="subprompt muted" id="subprompt" hidden></p>
    <form id="answer-form" class="answer">
      <div id="input-slot"></div>
    </form>
    <div id="card" class="card-wrap" hidden>
      <button type="button" class="flashcard" id="flip" aria-label="Flip card">
        <span class="face front"><span class="small muted">tap to flip</span></span>
        <span class="face back" hidden>
          <span class="card-answer" id="card-answer"></span>
          <span class="card-reveal small muted" id="card-reveal"></span>
        </span>
      </button>
      <div class="rate" id="rate" hidden>
        <button type="button" class="btn rate-again" id="again-card">Again <kbd>1</kbd></button>
        <button type="button" class="btn btn-primary rate-ok" id="ok-card">Got it <kbd>2</kbd></button>
      </div>
    </div>
    <div id="feedback" class="feedback" hidden>
      <p class="verdict" id="verdict"></p>
      <p class="expected" id="expected"></p>
      <ul class="notes small" id="notes"></ul>
      <p class="reveal small muted" id="reveal"></p>
      <button type="button" class="btn btn-primary" id="next">Next</button>
    </div>
    <p class="small"><button type="button" class="linkish" id="quit">End session</button></p>
  </section>

  <!-- -------------------------------------------------------------- summary -->
  <section id="summary" class="summary" hidden>
    <h2>Done</h2>
    <p class="score" id="score"></p>
    <div id="missed"></div>
    <p>
      <button type="button" class="btn btn-primary" id="again">Same again</button>
      <button type="button" class="btn" id="back">Change setup</button>
    </p>
  </section>

  <!-- ---------------------------------------------------------------- stats -->
  <details class="stats" id="stats">
    <summary>Stats on this device</summary>
    <p class="small muted">Attempt and error counts are stored in this browser only. Your laptop and phone keep separate numbers; that is expected.</p>
    <div id="stats-table"></div>
    <p><button type="button" class="btn" id="reset-stats">Reset stats on this device</button></p>
  </details>
</Base>

<script>
  import vocab from '../data/vocab.json';
  import exercises from '../data/exercises.json';
  import rules from '../data/gender-rules.json';
  import { modes, getMode, conjugationItems, endingItems } from '../lib/quiz-modes.js';
  import { compareTyped, compareChoice } from '../lib/compare.js';
  import { loadStats, record, resetStats } from '../lib/quiz-stats.js';

  const $ = (id: string) => document.getElementById(id)!;
  const setup = $('setup') as HTMLFormElement;
  const play = $('play');
  const summary = $('summary');
  const inputSlot = $('input-slot');
  const answerForm = $('answer-form') as HTMLFormElement;
  const feedback = $('feedback');

  type Entry = any;
  let stats = loadStats();
  const ALL: Record<string, Entry[]> = { vocab, exercises, rules, conjugation: conjugationItems(vocab), endings: endingItems() };
  const ctx = ALL;
  const dataFor = (mode: any): Entry[] => ALL[mode.source ?? 'vocab'];
  const lookup = (id: string): Entry | undefined =>
    vocab.find((e) => e.id === id) ?? exercises.find((e) => e.id === id) ?? rules.find((e) => e.id === id) ??
    ALL.conjugation.find((e) => e.id === id) ?? ALL.endings.find((e) => e.id === id);

  // --- pool + config ------------------------------------------------------
  function readConfig() {
    const fd = new FormData(setup);
    return {
      mode: String(fd.get('mode')),
      from: Number(fd.get('from')) || 1,
      to: Number(fd.get('to')) || 999,
      tag: String(fd.get('tag') || ''),
      essentials: fd.get('essentials') === 'on',
      style: String(fd.get('style') || 'quiz'),
      length: Math.max(1, Number(fd.get('length')) || 15),
    };
  }
  function poolFor(cfg: ReturnType<typeof readConfig>) {
    const mode = getMode(cfg.mode)!;
    return dataFor(mode).filter(
      (e) =>
        mode.filter(e, ctx) &&
        e.lesson >= cfg.from &&
        e.lesson <= cfg.to &&
        (!cfg.tag || e.tags.includes(cfg.tag)) &&
        // essentials applies to vocab-derived sets; worksheets, rules and endings are small already
        (!cfg.essentials || !['vocab', 'conjugation'].includes(mode.source ?? 'vocab') || e.tags.includes('essentials')),
    );
  }
  function updatePoolInfo() {
    const cfg = readConfig();
    // per-mode counts respect the lesson/tag filter so the numbers are honest
    for (const m of modes) {
      const n = poolFor({ ...cfg, mode: m.id }).length;
      const el = document.querySelector(`[data-mode-count="${m.id}"]`)!;
      el.textContent = `${n} word${n === 1 ? '' : 's'}`;
    }
    const n = poolFor(cfg).length;
    $('pool').textContent = n ? `${n} words match. Session: ${Math.min(n, cfg.length)} questions.` : 'No words match these filters.';
    ($('start') as HTMLButtonElement).disabled = n === 0;
  }
  // ?mode=<id> preselects a mode (lesson pages link here per exercise set)
  const wanted = new URLSearchParams(location.search).get('mode');
  if (wanted && getMode(wanted)) {
    const radio = setup.querySelector<HTMLInputElement>(`input[name=mode][value="${wanted}"]`);
    if (radio) radio.checked = true;
  }
  setup.addEventListener('input', updatePoolInfo);
  updatePoolInfo();

  // --- session --------------------------------------------------------------
  let session: { mode: any; style: string; queue: Entry[]; index: number; results: { entry: Entry; correct: boolean; given: string }[] } | null = null;
  const card = $('card');
  const flip = $('flip') as HTMLButtonElement;
  const front = flip.querySelector<HTMLElement>('.front')!;
  const back = flip.querySelector<HTMLElement>('.back')!;

  function shuffle<T>(arr: T[]): T[] {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function start() {
    const cfg = readConfig();
    const mode = getMode(cfg.mode)!;
    const pool = poolFor(cfg);
    if (!pool.length) return;
    session = { mode, style: cfg.style, queue: shuffle(pool).slice(0, cfg.length), index: 0, results: [] };
    setup.hidden = true;
    summary.hidden = true;
    play.hidden = false;
    $('mode-name').textContent = `${mode.label}${cfg.style === 'cards' ? ' · flashcards' : ''}`;
    ask();
  }

  function ask() {
    if (!session) return;
    const { mode, queue, index } = session;
    if (index >= queue.length) return finish();
    const entry = queue[index];
    $('qnum').textContent = `${index + 1} / ${queue.length}`;
    $('prompt').textContent = mode.prompt(entry, ctx);
    $('prompt').setAttribute('lang', mode.id === 'en-de' ? 'en' : 'de');
    const sub = mode.subprompt ? mode.subprompt(entry, ctx) : null;
    $('subprompt').textContent = sub ?? '';
    $('subprompt').hidden = !sub;
    feedback.hidden = true;
    inputSlot.innerHTML = '';

    if (session.style === 'cards') {
      answerForm.hidden = true;
      card.hidden = false;
      front.hidden = false;
      back.hidden = true;
      $('rate').hidden = true;
      $('card-answer').innerHTML = renderAnswer(entry, mode.answer(entry, ctx));
      const reveal = mode.reveal ? mode.reveal(entry, ctx) : null;
      $('card-reveal').textContent = reveal ?? '';
      flip.setAttribute('aria-pressed', 'false');
      flip.focus();
      return;
    }
    card.hidden = true;
    answerForm.hidden = false;

    if (mode.input === 'typed') {
      const input = document.createElement('input');
      input.type = 'text';
      input.name = 'answer';
      input.autocomplete = 'off';
      input.autocapitalize = 'off';
      input.spellcheck = false;
      input.setAttribute('lang', mode.id === 'en-de' ? 'de' : 'en');
      input.setAttribute('aria-label', 'Your answer');
      const btn = document.createElement('button');
      btn.type = 'submit';
      btn.className = 'btn';
      btn.textContent = 'Check';
      // Explicit Enter handling so submission never depends on implicit form submit.
      input.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter') {
          ev.preventDefault();
          ev.stopPropagation(); // the document-level Enter handler must not also advance
          grade(input.value);
        }
      });
      inputSlot.append(input, btn);
      input.focus();
    } else {
      for (const opt of mode.input.options) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = `btn choice choice-${opt}`;
        b.textContent = opt;
        b.addEventListener('click', () => grade(opt));
        inputSlot.append(b);
      }
      (inputSlot.querySelector('button') as HTMLButtonElement).focus();
    }
  }

  answerForm.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const input = inputSlot.querySelector<HTMLInputElement>('input[name=answer]');
    if (input) grade(input.value);
  });

  function grade(given: string) {
    if (!session) return;
    const { mode, queue, index } = session;
    const entry = queue[index];
    const expected = mode.answer(entry, ctx);
    const result =
      mode.input === 'typed'
        ? compareTyped(given, mode.accept ? mode.accept(entry, ctx) : [{ text: expected, note: null }])
        : compareChoice(given, expected);

    record(stats, entry.id, result.correct);
    session.results.push({ entry, correct: result.correct, given });

    answerForm.hidden = true;
    feedback.hidden = false;
    const verdict = $('verdict');
    verdict.textContent = result.correct ? (result.exact ? 'Correct' : 'Correct, but…') : 'Not quite';
    verdict.className = `verdict ${result.correct ? (result.exact ? 'ok' : 'warn') : 'bad'}`;
    $('expected').innerHTML = result.correct && result.exact ? '' : `<span class="muted">Answer:</span> ${renderAnswer(entry, expected)}`;
    if (result.correct && result.exact && mode.id === 'en-de' && entry.pos === 'noun') {
      $('expected').innerHTML = renderAnswer(entry, expected);
    }
    const notes = $('notes');
    notes.innerHTML = '';
    for (const n of result.notes) {
      const li = document.createElement('li');
      li.textContent = n;
      notes.append(li);
    }
    const reveal = mode.reveal ? mode.reveal(entry, ctx) : null;
    $('reveal').textContent = reveal ?? '';
    $('reveal').hidden = !reveal;
    const s = stats[entry.id];
    if (s && s.attempts > 1) {
      $('reveal').textContent += `${reveal ? ' · ' : ''}${s.errors}/${s.attempts} wrong on this device`;
      $('reveal').hidden = false;
    }
    $('next').focus();
  }

  function renderAnswer(entry: Entry, expected: string) {
    // colour the article when the expected answer is a German noun or an article
    const m = /^(der|die|das)( .*)?$/.exec(expected);
    if (m && (entry.pos === 'noun' || !m[2])) {
      return `<span class="g g-${m[1]}">${m[1]}</span>${m[2] ?? ''}`;
    }
    return escape(expected);
  }
  function escape(s: string) {
    return s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
  }

  // --- flashcards: flip, then self-rate --------------------------------------
  function showBack() {
    if (!back.hidden) return;
    front.hidden = true;
    back.hidden = false;
    $('rate').hidden = false;
    flip.setAttribute('aria-pressed', 'true');
    ($('ok-card') as HTMLButtonElement).focus();
  }
  function rate(correct: boolean) {
    if (!session || back.hidden) return;
    const { mode, queue, index } = session;
    const entry = queue[index];
    record(stats, entry.id, correct);
    session.results.push({ entry, correct, given: correct ? mode.answer(entry, ctx) : '' });
    session.index++;
    ask();
  }
  flip.addEventListener('click', showBack);
  $('again-card').addEventListener('click', () => rate(false));
  $('ok-card').addEventListener('click', () => rate(true));
  document.addEventListener('keydown', (ev) => {
    if (!session || session.style !== 'cards' || play.hidden) return;
    if (ev.target instanceof HTMLInputElement) return;
    if (ev.key === ' ' || (ev.key === 'Enter' && back.hidden)) { ev.preventDefault(); showBack(); }
    else if (ev.key === '1') { ev.preventDefault(); rate(false); }
    else if (ev.key === '2' || (ev.key === 'Enter' && !back.hidden)) { ev.preventDefault(); rate(true); }
  });

  $('next').addEventListener('click', () => {
    if (!session) return;
    session.index++;
    ask();
  });
  // Enter advances once feedback is showing. preventDefault also cancels the
  // focused Next button's native activation, so a single keypress = one click.
  document.addEventListener('keydown', (ev) => {
    if (session?.style !== 'cards' && ev.key === 'Enter' && !feedback.hidden && !play.hidden) {
      ev.preventDefault();
      ($('next') as HTMLButtonElement).click();
    }
  });
  $('quit').addEventListener('click', finish);

  function finish() {
    if (!session) return;
    play.hidden = true;
    card.hidden = true;
    summary.hidden = false;
    const { results, mode } = session;
    const right = results.filter((r) => r.correct).length;
    $('score').textContent = results.length
      ? `${right} / ${results.length} ${session.style === 'cards' ? 'got it' : 'correct'} · ${mode.label}`
      : 'No answers given.';
    const missed = results.filter((r) => !r.correct);
    const box = $('missed');
    box.innerHTML = '';
    if (missed.length) {
      const h = document.createElement('h3');
      h.textContent = 'To review';
      const ul = document.createElement('ul');
      ul.className = 'missed';
      for (const r of missed) {
        const li = document.createElement('li');
        li.innerHTML = `<span lang="de">${escape(mode.prompt(r.entry, ctx))}</span> <span class="muted">→</span> ${renderAnswer(r.entry, mode.answer(r.entry, ctx))}` +
          (r.given ? ` <span class="small muted">(you: ${escape(r.given)})</span>` : '');
        ul.append(li);
      }
      box.append(h, ul);
    }
    renderStats();
  }

  $('again').addEventListener('click', start);
  $('back').addEventListener('click', () => {
    summary.hidden = true;
    setup.hidden = false;
    session = null;
    updatePoolInfo();
  });
  setup.addEventListener('submit', (ev) => {
    ev.preventDefault();
    start();
  });

  // --- stats ------------------------------------------------------------------
  function renderStats() {
    const box = $('stats-table');
    const rows = Object.entries(stats)
      .map(([id, s]: [string, any]) => ({ id, ...s, entry: lookup(id) }))
      .filter((r) => r.entry)
      .sort((a, b) => b.errors / b.attempts - a.errors / a.attempts || b.attempts - a.attempts);
    if (!rows.length) {
      box.innerHTML = '<p class="small muted">No attempts recorded yet.</p>';
      return;
    }
    const table = document.createElement('table');
    table.className = 'stats-table';
    table.innerHTML = '<thead><tr><th>Word</th><th>Attempts</th><th>Errors</th></tr></thead>';
    const tb = document.createElement('tbody');
    for (const r of rows) {
      const tr = document.createElement('tr');
      const label = r.entry.german ?? r.entry.full_de ?? r.entry.suffix ?? (r.entry.form ? `${r.entry.verb.german} · ${r.entry.pronoun.de}` : r.entry.pronoun?.de ?? r.id);
      tr.innerHTML = `<td lang="de">${renderAnswer(r.entry, label)}</td><td>${r.attempts}</td><td>${r.errors}</td>`;
      tb.append(tr);
    }
    table.append(tb);
    box.innerHTML = '';
    box.append(table);
  }
  $('reset-stats').addEventListener('click', () => {
    if (!confirm('Reset all quiz stats stored on this device?')) return;
    resetStats();
    stats = loadStats();
    renderStats();
  });
  renderStats();
</script>

<style>
  .setup { max-width: 40rem; display: grid; gap: 1rem; }
  fieldset { border: 1px solid var(--border); border-radius: var(--radius); padding: 0.75rem 1rem 1rem; margin: 0; }
  legend { padding: 0 0.4em; color: var(--muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .mode-group + .mode-group { margin-top: 0.9rem; }
  .group-title { margin: 0 0 0.4rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
  .modes { display: grid; gap: 0.5rem; }
  @media (min-width: 36rem) { .modes { grid-template-columns: 1fr 1fr; } }
  .mode {
    display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto auto; gap: 0 0.6rem; align-items: start;
    padding: 0.6rem 0.75rem; border: 1px solid var(--border); border-radius: var(--radius); cursor: pointer; background: var(--surface);
  }
  .mode:has(input:checked) { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .mode input { grid-row: 1 / span 3; margin: 0.3em 0 0; accent-color: var(--accent); }
  .mode-label { font-weight: 600; }
  .row { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; }
  .row label { display: grid; gap: 0.25rem; font-size: 0.9rem; }
  .row input, .row select { padding: 0.4em 0.5em; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); min-height: 2.4rem; }
  .row input[type=number] { width: 4.5rem; }
  .row label.check { display: inline-flex; flex-direction: row; align-items: center; gap: 0.4rem; align-self: end; min-height: 2.4rem; }
  .row label.check input { accent-color: var(--accent); width: 1.1rem; height: 1.1rem; }
  .range { display: inline-flex; align-items: center; gap: 0.4rem; }

  .play { max-width: 40rem; }
  .styles { display: grid; gap: 0.5rem; }
  @media (min-width: 36rem) { .styles { grid-template-columns: 1fr 1fr; } }
  .card-wrap { display: grid; gap: 0.75rem; }
  .flashcard {
    all: unset; box-sizing: border-box; display: block; width: 100%; min-height: 9rem; cursor: pointer;
    padding: 1.25rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface);
    text-align: center;
  }
  .flashcard:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .flashcard[aria-pressed="true"] { background: var(--surface-2); cursor: default; }
  .face { display: grid; gap: 0.5rem; place-items: center; min-height: 6.5rem; }
  .card-answer { font-size: 1.6rem; font-weight: 600; line-height: 1.25; overflow-wrap: anywhere; }
  .rate { display: flex; gap: 0.5rem; }
  .rate .btn { flex: 1; font-size: 1.05rem; padding: 0.7em 1em; }
  .rate-again { color: var(--bad); }
  kbd { font-family: var(--mono); font-size: 0.7em; opacity: 0.6; margin-left: 0.3em; }
  .prompt { font-size: 1.9rem; font-weight: 600; margin: 0.5rem 0 1rem; line-height: 1.25; overflow-wrap: anywhere; }
  .prompt:has(+ .subprompt:not([hidden])) { margin-bottom: 0.25rem; }
  .subprompt { margin: 0 0 1rem; }
  .answer { display: flex; flex-direction: column; gap: 0.5rem; }
  #input-slot { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  #input-slot input[type=text] {
    flex: 1 1 14rem; font-size: 1.15rem; padding: 0.55em 0.7em;
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface);
  }
  .choice { flex: 1 1 6rem; font-size: 1.1rem; padding: 0.7em 1em; font-weight: 600; }
  .choice-der { color: var(--der); }
  .choice-die { color: var(--die); }
  .choice-das { color: var(--das); }
  .feedback { margin-top: 1rem; padding: 1rem; border-radius: var(--radius); background: var(--surface-2); }
  .verdict { font-weight: 700; margin: 0 0 0.25rem; }
  .verdict.ok { color: var(--ok); }
  .verdict.warn { color: var(--warn); }
  .verdict.bad { color: var(--bad); }
  .expected { font-size: 1.2rem; margin: 0 0 0.25rem; }
  .expected:empty { display: none; }
  .notes { margin: 0 0 0.5rem; padding-left: 1.2em; }
  .notes:empty { display: none; }
  .linkish { all: unset; cursor: pointer; color: var(--accent); text-decoration: underline; }

  .summary { max-width: 40rem; }
  .score { font-size: 1.3rem; font-weight: 600; }
  .missed { padding-left: 1.2em; }
  .stats { margin-top: 2.5rem; max-width: 40rem; }
  .stats summary { cursor: pointer; font-weight: 600; }
  .stats-table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
  .stats-table th, .stats-table td { text-align: left; padding: 0.3em 0.5em; border-bottom: 1px solid var(--border); }
