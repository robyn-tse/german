---
import Base from '../layouts/Base.astro';
import { Content, getHeadings } from '../review/grammar.md';

// Section list for the jump menu, built from the markdown's ## headings.
const sections = getHeadings()
  .filter((h) => h.depth === 2)
  .map((h) => ({ slug: h.slug, label: h.text.replace(/^\d+\.\s*/, '').replace(/\s*\(.*\)$/, '') }));
---
<Base title="Review" description="Grammar review sheet: one page, ten topics.">
  <p class="small muted">Review · grammar</p>
  <h1>Grammar review</h1>
  <p class="muted small intro">Everything from Markus's grammar materials on one page, in the order each topic builds on the last. Tap a chart to open it full size.</p>

  <nav class="jump" aria-label="Sections">
    <ol>
      {sections.map((s, i) => (
        <li><a href={`#${s.slug}`}><span class="n">{i + 1}</span>{s.label}</a></li>
      ))}
    </ol>
  </nav>

  <article class="prose review"><Content /></article>

  <p class="small top"><a href="#">↑ Back to top</a></p>
  <script type="application/json" id="pool-url" set:html={JSON.stringify(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/review-pool.json`)} />
</Base>

<script>
  import { compareTyped } from '../lib/compare.js';
  import { loadStats, record } from '../lib/quiz-stats.js';

  type Ex = {
    id: string; prompt_de: string; hint: string | null; hint_en: string | null; answer: string;
    also: string | null; full_de: string; en: string | null; note: string | null; gloss: [string, string | null][];
  };

  const ROUND = 25;
  const poolUrl = JSON.parse(document.getElementById('pool-url')!.textContent!);
  let poolsPromise: Promise<Record<string, Ex[]>> | null = null;
  const loadPools = () => (poolsPromise ??= fetch(poolUrl).then((r) => r.json()));
  const stats = loadStats();

  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const shuffle = <T,>(a: T[]) => {
    const b = a.slice();
    for (let i = b.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [b[i], b[j]] = [b[j], b[i]]; }
    return b;
  };
  const col = (de: string, en: string | null, cls = '') =>
    `<span class="w ${cls}"><span class="en">${en ? esc(en) : ''}</span><span class="de">${esc(de)}</span></span>`;
  const candidates = (e: Ex) => [{ text: e.answer, note: null }, ...(e.also ? [{ text: e.also, note: e.note }] : [])];

  for (const slot of document.querySelectorAll<HTMLElement>('.practice')) {
    const section = slot.dataset.section!;
    slot.innerHTML = `
      <details class="more practice-box">
        <summary>Practise: ${ROUND} homework questions</summary>
        <div class="pq" aria-live="polite"><p class="muted small">Loading…</p></div>
      </details>`;
    const details = slot.querySelector('details')!;
    const box = slot.querySelector<HTMLElement>('.pq')!;
    let started = false;
    details.addEventListener('toggle', async () => {
      if (!details.open || started) return;
      started = true;
      const pool = (await loadPools())[section] ?? [];
      if (!pool.length) { box.innerHTML = '<p class="muted small">No homework questions for this topic yet.</p>'; return; }
      run(box, pool, shuffle(pool).slice(0, ROUND));
    });
  }

  function run(box: HTMLElement, pool: Ex[], queue: Ex[]) {
    let i = 0;
    const wrong: Ex[] = [];

    function ask() {
      if (i >= queue.length) return finish();
      const e = queue[i];
      const hint = e.hint ? col(`(${e.hint})`, e.hint_en, 'hint') : '';
      box.innerHTML = `
        <p class="small muted pq-count">Question ${i + 1} of ${queue.length}${wrong.length ? ` · ${wrong.length} wrong` : ''}</p>
        <p class="pq-prompt" lang="de">${e.gloss.map(([t, g]) => col(t, g)).join('')}${hint}</p>
        ${e.en ? `<p class="small muted pq-en">${esc(e.en)}</p>` : ''}
        <form class="pq-form"><input type="text" name="a" autocomplete="off" autocapitalize="off" spellcheck="false" lang="de" aria-label="Your answer" placeholder="Fill the gap${(e.prompt_de.match(/___/g) || []).length > 1 ? 's, in order' : ''}" /><button class="btn btn-primary" type="submit">Check</button></form>
        <div class="pq-fb" hidden></div>`;
      const form = box.querySelector('form')!;
      const input = form.querySelector('input')!;
      input.focus({ preventScroll: true });
      form.addEventListener('submit', (ev) => { ev.preventDefault(); grade(e, input.value); });
    }

    function grade(e: Ex, given: string) {
      if (!given.trim()) return;
      const r = compareTyped(given, candidates(e));
      record(stats, e.id, r.correct);
      if (!r.correct) wrong.push(e);
      box.querySelector('form')!.hidden = true;
      const fb = box.querySelector<HTMLElement>('.pq-fb')!;
      fb.hidden = false;
      const notes = [...r.notes, ...(e.note && !r.notes.includes(e.note) ? [e.note] : [])];
      fb.innerHTML = `
        <p class="pq-verdict ${r.correct ? (r.exact ? 'ok' : 'warn') : 'bad'}">${r.correct ? (r.exact ? 'Correct' : 'Correct, but…') : 'Not quite'}</p>
        ${r.correct ? '' : `<p><span class="muted">You typed:</span> <s>${esc(given.trim())}</s></p>`}
        <p class="pq-full" lang="de">${esc(e.full_de)}</p>
        ${notes.length ? `<ul class="small">${notes.map((n) => `<li>${esc(n)}</li>`).join('')}</ul>` : ''}
        ${r.correct ? '' : `<form class="pq-form pq-retype"><input type="text" autocomplete="off" autocapitalize="off" spellcheck="false" lang="de" aria-label="Type the correct answer" placeholder="Retype the answer" /><button class="btn" type="submit">OK</button></form>`}
        <button class="btn btn-primary pq-next" type="button" ${r.correct ? '' : 'disabled'}>${i + 1 < queue.length ? 'Next' : 'See results'}</button>`;
      const next = fb.querySelector<HTMLButtonElement>('.pq-next')!;
      next.addEventListener('click', () => { i++; ask(); box.querySelector<HTMLInputElement>('input')?.scrollIntoView({ block: 'nearest' }); });
      const retype = fb.querySelector<HTMLFormElement>('.pq-retype');
      if (retype) {
        const ri = retype.querySelector('input')!;
        ri.focus({ preventScroll: true });
        retype.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (compareTyped(ri.value, candidates(e)).correct) {
            retype.outerHTML = '<p class="small ok-text">Right. Carry on.</p>';
            next.disabled = false;
            next.focus();
          } else {
            ri.select();
          }
        });
      } else {
        next.focus({ preventScroll: true });
      }
    }

    function finish() {
      const right = queue.length - wrong.length;
      box.innerHTML = `
        <p class="pq-verdict ${wrong.length ? 'warn' : 'ok'}">${right} of ${queue.length} right first time</p>
        <div class="pq-actions">
          ${wrong.length ? '<button class="btn btn-primary" type="button" data-act="retry">Retry the ones I got wrong</button>' : ''}
          <button class="btn" type="button" data-act="new">Another ${Math.min(ROUND, pool.length)}</button>
        </div>`;
      box.querySelector('[data-act=retry]')?.addEventListener('click', () => run(box, pool, shuffle(wrong)));
      box.querySelector('[data-act=new]')!.addEventListener('click', () => run(box, pool, shuffle(pool).slice(0, ROUND)));
    }

    ask();
  }
</script>

<style>
  .intro { max-width: var(--measure); }

  .jump ol {
    list-style: none; margin: 1rem 0 0.5rem; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.4rem;
    max-width: var(--measure);
  }
  .jump a {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.3rem 0.65rem 0.3rem 0.35rem;
    border: 1px solid var(--border); border-radius: 999px;
    background: var(--surface);
    color: var(--fg); text-decoration: none; font-size: 0.85rem; line-height: 1.3;
  }
  .jump a:hover { border-color: var(--accent); background: var(--accent-soft); }
  .jump .n {
    display: inline-grid; place-items: center;
    min-width: 1.35rem; height: 1.35rem; border-radius: 999px;
    background: var(--accent-soft); color: var(--accent);
    font-size: 0.75rem; font-weight: 700;
  }

  /* Each topic reads as its own block; headings land below the top edge when jumped to. */
  .review :global(h2) { scroll-margin-top: 1rem; margin-top: 2.5em; }
  .review :global(img.narrow) { max-width: 20rem; }
  .review :global(.pair) { display: grid; gap: 0.75rem; }
  .review :global(.pair img) { margin: 0; }
  @media (min-width: 40rem) {
    .review :global(.pair) { grid-template-columns: 1fr 1fr; }
  }
  .review :global(.chart-note) {
    margin: -0.75rem 0 1.5rem; padding: 0.6rem 0.85rem;
    background: var(--accent-soft); border-radius: var(--radius);
    font-size: 0.9rem; line-height: 1.5;
  }
  .review :global(.chart-note strong) { color: var(--fg); }
  /* Long word lists start collapsed. */
  .review :global(details.more) {
    margin: 1rem 0 1.5rem; border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface);
  }
  .review :global(details.more > summary) {
    cursor: pointer; padding: 0.7rem 0.9rem; font-weight: 600; color: var(--accent);
    list-style: none; display: flex; align-items: center; gap: 0.5rem;
  }
  .review :global(details.more > summary::-webkit-details-marker) { display: none; }
  .review :global(details.more > summary::before) {
    content: '▸'; transition: transform 0.15s; display: inline-block;
  }
  .review :global(details.more[open] > summary::before) { transform: rotate(90deg); }
  .review :global(details.more > table) { margin: 0 0.6rem 0.6rem; width: calc(100% - 1.2rem); }
  @media (prefers-reduced-motion: reduce) {
    .review :global(details.more > summary::before) { transition: none; }
  }
  /* Practice box: homework format, English above each German word. */
  .review :global(.practice-box) { border-color: var(--accent); }
  .review :global(.practice-box > summary) { color: var(--accent); }
  .review :global(.pq) { padding: 0 0.9rem 0.9rem; }
  .review :global(.pq-count) { margin: 0 0 0.25rem; }
  .review :global(.pq-prompt) {
    display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.2em 0.55em;
    font-size: 1.35rem; font-weight: 600; line-height: 1.15; margin: 0.5rem 0;
  }
  .review :global(.pq-prompt .w) { display: inline-flex; flex-direction: column; align-items: flex-start; white-space: nowrap; }
  .review :global(.pq-prompt .en) { font-size: 0.55em; font-weight: 400; color: var(--accent); line-height: 1.3; min-height: 1.3em; }
  .review :global(.pq-prompt .hint .de) { color: var(--muted); font-weight: 400; }
  .review :global(.pq-en) { margin: 0 0 0.75rem; font-style: italic; }
  .review :global(.pq-form) { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.5rem 0; }
  .review :global(.pq-form input) {
    flex: 1 1 12rem; font-size: 1.1rem; padding: 0.5em 0.7em; color: var(--fg);
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg);
  }
  .review :global(.pq-fb) { margin-top: 0.5rem; padding: 0.75rem; border-radius: var(--radius); background: var(--surface-2); }
  .review :global(.pq-fb p) { margin: 0 0 0.4rem; }
  .review :global(.pq-fb s) { color: var(--bad); }
  .review :global(.pq-full) { font-size: 1.1rem; font-weight: 600; }
  .review :global(.pq-verdict) { font-weight: 700; margin: 0.25rem 0 0.5rem; }
  .review :global(.pq-verdict.ok), .review :global(.ok-text) { color: var(--ok); }
  .review :global(.pq-verdict.warn) { color: var(--warn); }
  .review :global(.pq-verdict.bad) { color: var(--bad); }
  .review :global(.pq-actions) { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .top { margin-top: 2.5rem; }
</style>
